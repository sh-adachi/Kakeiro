# generate_env.py creates random local secrets without printing them.
KAKEIRO_API_TOKEN=GENERATE_RANDOM_OWNER_TOKEN
KAKEIRO_ENCRYPTION_KEY=GENERATE_FERNET_KEY
KAKEIRO_DATABASE=data/kakeiro.sqlite3
KAKEIRO_BIND=127.0.0.1
KAKEIRO_PORT=8787

# Supplied by Moneytree after client registration; blank means unconfigured.
MONEYTREE_ENVIRONMENT=staging
MONEYTREE_CLIENT_ID=
MONEYTREE_REDIRECT_URI=kakeiro://moneytree/callback
# iOS must be registered as a public PKCE client. Never put a client secret in iOS.
# Set this ONLY if Moneytree explicitly issues a server-side refresh secret.
MONEYTREE_CLIENT_SECRET=
# Set true only after the acceptance checks in Docs/BackendSetup.md.
MONEYTREE_SIGNED_AMOUNTS_VERIFIED=false

# Docker/Caddy example only: replace with your own existing domain when deploying.
KAKEIRO_DOMAIN=finance.example.invalid
